{
  "name": "robosmith-extension",
  "publisher": "robosmith",
  "version": "0.0.1",
  "description": "RoboSmith VS Code Extension",
  "private": true,
  "main": "./out/packages/client/src/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWorkspaceContains:.vision/workflows.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "roboSmith.showNavigator",
        "title": "RoboSmith: Show Navigator"
      },
      {
        "command": "roboSmith.openCockpit",
        "title": "RoboSmith: Open Cockpit"
      },
      {
        "command": "roboSmith.showAiCallInspector",
        "title": "RoboSmith: Show AI Call Inspector"
      }
    ]
  },
  "scripts": {
    "build": "run-p build:client build:webview",
    "build:client": "pnpm --filter client build",
    "build:webview": "pnpm --filter robosmith-webview-ui build",
    "test": "run-s test:node test:browser",
    "test:node": "vitest run -c vitest.config.node.mts",
    "test:browser": "vitest run -c vitest.config.browser.mts",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "// --- CONTEXT SLICER (Development) ---": "",
    "slicer": "./context-slicer/slicer",
    "dev:slicer:ui": "cd context-slicer && pnpm dev",
    "dev:slicer:watcher": "cd context-slicer && node --loader ts-node/esm scripts/generate-dump.ts --watch"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.105.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "globals": "^15.12.0",
    "happy-dom": "^20.0.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.3",
    "svelte": "^5.45.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte-inspector": "^5.0.1",
    "execa": "^5.1.1",
    "immer": "^10.1.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.2"
  }
}
