{
  "name": "robosmith-extension",
  "version": "0.0.1",
  "description": "RoboSmith VS Code Extension",
  "private": true,
  "scripts": {
    "test": "run-s test:node test:browser",
    "test:node": "vitest run -c vitest.config.node.mts",
    "test:browser": "vitest run -c vitest.config.browser.mts",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "// --- CONTEXT SLICER (Development) ---": "",
    "slicer": "./context-slicer/slicer",
    "dev:slicer:ui": "cd context-slicer && pnpm dev",
    "dev:slicer:watcher": "cd context-slicer && node --loader ts-node/esm scripts/generate-dump.ts --watch"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.105.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.1",
    "svelte": "^5.45.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte-inspector": "^5.0.1",
    "immer": "^11.0.0",
    "zustand": "^5.0.8"
  }
}